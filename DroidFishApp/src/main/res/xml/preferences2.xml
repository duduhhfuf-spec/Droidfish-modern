<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="Внешний вид"
        app:iconSpaceReserved="false">
        
        <ListPreference
            android:key="board_theme"
            android:title="Тема доски"
            android:summary="Выберите цветовую схему доски"
            android:entries="@array/board_theme_names"
            android:entryValues="@array/board_theme_values"
            android:defaultValue="GREEN"
            app:iconSpaceReserved="false" />
            
        <ListPreference
            android:key="piece_set"
            android:title="Набор фигур"
            android:summary="Выберите стиль шахматных фигур"
            android:entries="@array/piece_set_names"
            android:entryValues="@array/piece_set_values"
            android:defaultValue="CBURNITT"
            app:iconSpaceReserved="false" />
            
        <ListPreference
            android:key="sound_set"
            android:title="Набор звуков"
            android:summary="Выберите звуки ходов и интерфейса"
            android:entries="@array/sound_set_names"
            android:entryValues="@array/sound_set_values"
            android:defaultValue="STANDARD"
            app:iconSpaceReserved="false" />
            
    </PreferenceCategory>

</PreferenceScreen>
